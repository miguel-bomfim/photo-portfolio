---
import CustomCursor from "../components/CustomCursor.astro";
import ContactFooter from "../components/ContactFooter.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "works" | "about" | "blog";
}

const { title, description, active = "home" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
    <script is:inline>
      const cursorMedia = matchMedia("(hover: hover) and (pointer: fine)");
      if (cursorMedia.matches) {
        document.documentElement.classList.add("custom-cursor-pending");
        window.setTimeout(() => {
          if (
            !document.documentElement.classList.contains("has-custom-cursor")
          ) {
            document.documentElement.classList.remove("custom-cursor-pending");
          }
        }, 2500);
      }

      const savedTheme = localStorage.getItem("sarah-theme");
      const theme =
        savedTheme ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <CustomCursor />

    <header
      class:list={{
        "site-header": true,
        "site-header--overlay": active === "home",
      }}
    >
      <a class="brand" href="/" aria-label="Sarah, página inicial">
        Sarah Heloísa
      </a>

      <nav class="nav" aria-label="Navegação principal">
        <a
          class:list={{ "desktop-link": true, "is-active": active === "home" }}
          href="/">Início</a
        >
        <a class:list={{ "primary-nav-link": true, "is-active": active === "works" }} href="/trabalhos"
          >Trabalhos</a
        >
        <a class:list={{ "primary-nav-link": true, "is-active": active === "about" }} href="/sobre"
          >Sobre</a
        >
        <a class:list={{ "primary-nav-link": true, "is-active": active === "blog" }} href="/blog">Blog</a>
        <button class="theme-toggle theme-toggle--desktop" type="button" aria-label="Alternar tema">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"
              fill="currentColor"></path>
          </svg>
        </button>
        <div class="mobile-menu">
          <button
            class="mobile-menu-toggle"
            type="button"
            aria-label="Abrir menu"
            aria-controls="mobile-menu-panel"
            aria-expanded="false"
          >
            <span></span><span></span><span></span>
          </button>
          <button class="mobile-menu-backdrop" type="button" tabindex="-1" aria-label="Fechar menu"></button>
          <aside id="mobile-menu-panel" class="mobile-menu-panel" aria-label="Menu principal" aria-hidden="true" inert>
            <div class="mobile-menu-head">
              <span>Navegação</span>
              <button class="mobile-menu-close" type="button" aria-label="Fechar menu">
                <span></span><span></span>
              </button>
            </div>
            <div class="mobile-menu-links">
              <a class:list={{ "is-active": active === "home" }} href="/">Início</a>
              <a class:list={{ "is-active": active === "works" }} href="/trabalhos">Trabalhos</a>
              <a class:list={{ "is-active": active === "about" }} href="/sobre">Sobre</a>
              <a class:list={{ "is-active": active === "blog" }} href="/blog">Blog</a>
            </div>
            <div class="mobile-menu-theme">
              <span>Alternar tema</span>
              <button class="theme-toggle theme-toggle--mobile" type="button" aria-label="Alternar tema">
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path
                    d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"
                    fill="currentColor"></path>
                </svg>
              </button>
            </div>
          </aside>
        </div>
      </nav>
    </header>

    <slot />
    <ContactFooter />

    <script is:inline>
      const setThemeColor = () => {
        const color = getComputedStyle(document.documentElement)
          .getPropertyValue("--paper")
          .trim();
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", color);
      };
      setThemeColor();

      document.querySelectorAll(".theme-toggle").forEach((toggle) => {
        toggle.addEventListener("click", () => {
          const next =
            document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = next;
          localStorage.setItem("sarah-theme", next);
          setThemeColor();
        });
      });

      const menu = document.querySelector(".mobile-menu");
      const menuToggle = document.querySelector(".mobile-menu-toggle");
      const menuPanel = document.querySelector(".mobile-menu-panel");
      const menuClose = document.querySelector(".mobile-menu-close");
      const menuBackdrop = document.querySelector(".mobile-menu-backdrop");
      const setMenuOpen = (open) => {
        menu?.classList.toggle("is-open", open);
        menuToggle?.setAttribute("aria-expanded", String(open));
        menuPanel?.setAttribute("aria-hidden", String(!open));
        menuPanel?.toggleAttribute("inert", !open);
        document.body.classList.toggle("menu-open", open);
        if (open) menuClose?.focus();
        else menuToggle?.focus();
      };
      menuToggle?.addEventListener("click", () => setMenuOpen(true));
      menuClose?.addEventListener("click", () => setMenuOpen(false));
      menuBackdrop?.addEventListener("click", () => setMenuOpen(false));
      menuPanel?.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", () => setMenuOpen(false))
      );
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && menu?.classList.contains("is-open")) setMenuOpen(false);
      });

      const overlayHeader = document.querySelector(".site-header--overlay");
      if (overlayHeader) {
        const syncHeader = () => {
          overlayHeader.classList.toggle("is-scrolled", window.scrollY > 80);
        };
        syncHeader();
        window.addEventListener("scroll", syncHeader, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 112px;
    padding: 18px clamp(18px, 2.5vw, 44px);
    background: var(--panel);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(14px);
  }

  .site-header--overlay {
    position: fixed;
    right: 0;
    left: 0;
    background: transparent;
    backdrop-filter: none;
    transition:
      background-color 280ms ease,
      border-color 280ms ease,
      box-shadow 280ms ease,
      backdrop-filter 280ms ease;
  }

  .site-header--overlay:not(.is-scrolled) {
    border-bottom-color: transparent;
    background-color: transparent !important;
    background-image: none !important;
    box-shadow: none;
    backdrop-filter: none;
  }

  .site-header--overlay.is-scrolled {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--paper) 91%, transparent);
    box-shadow: 0 10px 35px rgba(23, 23, 20, .06);
    backdrop-filter: blur(16px) saturate(120%);
  }

  .site-header--overlay:not(.is-scrolled) .brand,
  .site-header--overlay:not(.is-scrolled) .nav a,
  .site-header--overlay:not(.is-scrolled) .nav button,
  .site-header--overlay:not(.is-scrolled) .nav .is-active {
    color: var(--ink);
  }

  .site-header--overlay:not(.is-scrolled) .theme-toggle {
    border-color: color-mix(in srgb, var(--ink) 28%, transparent) !important;
  }

  .brand {
    font-size: clamp(17px, 1.4vw, 23px);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.04em;
  }

  .brand small {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font:
      300 9px/1 "DM Mono",
      monospace;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .mark {
    width: 50px;
    color: var(--accent);
    transition: transform 450ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .mark:hover {
    transform: rotate(180deg);
  }

  .nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(13px, 1.7vw, 29px);
  }

  .nav button,
  .nav a {
    position: relative;
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    font:
      500 clamp(11px, 0.85vw, 14px)/1 "DM Mono",
      monospace;
    letter-spacing: -0.03em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav button::after,
  .nav a::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 250ms ease;
  }

  .nav button:hover::after,
  .nav a:hover::after,
  .nav a.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav .is-active {
    color: var(--ink);
  }

  .theme-toggle {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid var(--line) !important;
    border-radius: 50%;
  }

  .mobile-menu {
    display: none;
  }

  .mobile-menu-toggle::after,
  .mobile-menu-backdrop::after,
  .mobile-menu-close::after {
    display: none;
  }

  .theme-toggle::after {
    display: none;
  }

  .theme-toggle svg {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 760px) {
    .site-header {
      min-height: 78px;
      grid-template-columns: 1fr auto;
      padding: 12px 16px;
    }

    .brand small,
    .nav .desktop-link {
      display: none;
    }

    .nav { gap: 0; }

    .nav .primary-nav-link {
      display: none;
    }

    .mobile-menu {
      position: relative;
      display: block;
    }

    .theme-toggle--desktop { display: none; }

    .mobile-menu-toggle {
      display: grid;
      width: 44px;
      height: 44px;
      padding: 12px !important;
      place-content: center;
      gap: 5px;
      border: 1px solid color-mix(in srgb, var(--ink) 28%, transparent) !important;
      border-radius: 50%;
      color: var(--ink) !important;
    }

    .mobile-menu-toggle span {
      display: block;
      width: 18px;
      height: 1px;
      background: currentColor;
      transition: transform 250ms ease, opacity 200ms ease;
    }

    .mobile-menu-backdrop {
      position: fixed !important;
      z-index: 29;
      inset: 0;
      width: 100%;
      height: 100%;
      padding: 0 !important;
      background: rgba(10, 10, 9, .48) !important;
      opacity: 0;
      pointer-events: none;
      backdrop-filter: blur(3px);
      transition: opacity 320ms ease;
    }

    .mobile-menu-panel {
      position: fixed;
      z-index: 30;
      top: 0;
      right: 0;
      display:flex;
      width:min(86vw, 390px);
      height:100dvh;
      padding:20px 20px 26px;
      border-left:1px solid var(--line);
      background:var(--paper);
      color:var(--ink);
      flex-direction:column;
      box-shadow:-24px 0 70px rgba(0,0,0,.18);
      visibility:hidden;
      transform:translateX(102%);
      transition:transform 420ms cubic-bezier(.22,.78,.25,1), visibility 0s linear 420ms;
    }

    .mobile-menu.is-open .mobile-menu-backdrop {
      opacity:1;
      pointer-events:auto;
    }

    .mobile-menu.is-open .mobile-menu-panel {
      visibility:visible;
      transform:translateX(0);
      transition-delay:0s;
    }

    .mobile-menu-head {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding-bottom:20px;
      border-bottom:1px solid var(--line);
      color:var(--muted);
      font:500 10px/1 "DM Mono",monospace;
      letter-spacing:.08em;
      text-transform:uppercase;
    }

    .mobile-menu-close {
      position:relative !important;
      width:44px;
      height:44px;
      padding:0 !important;
      border:1px solid var(--line) !important;
      border-radius:50%;
      color:var(--ink) !important;
    }

    .mobile-menu-close span {
      position:absolute;
      top:50%;
      left:50%;
      width:17px;
      height:1px;
      background:currentColor;
    }

    .mobile-menu-close span:first-child { transform:translate(-50%,-50%) rotate(45deg); }
    .mobile-menu-close span:last-child { transform:translate(-50%,-50%) rotate(-45deg); }

    .mobile-menu-links {
      display:flex;
      padding:clamp(46px,10vh,88px) 0 30px;
      flex-direction:column;
    }

    .mobile-menu-links a {
      display:flex;
      align-items:center;
      justify-content:space-between;
      padding:18px 2px;
      border-bottom:1px solid var(--line);
      color:var(--ink) !important;
      font:500 clamp(30px,10vw,48px)/1 "Manrope",sans-serif;
      letter-spacing:-.065em;
      text-transform:none;
    }

    .mobile-menu-links a::before {
      order:2;
      color:var(--muted);
      content:"↗";
      font:400 16px/1 "DM Mono",monospace;
      letter-spacing:0;
    }

    .mobile-menu-links a::after { display:none; }
    .mobile-menu-links a.is-active { color:var(--accent) !important; }

    .mobile-menu-theme {
      display:flex;
      align-items:center;
      justify-content:space-between;
      margin-top:auto;
      padding-top:20px;
      border-top:1px solid var(--line);
      color:var(--muted);
      font:500 10px/1 "DM Mono",monospace;
      letter-spacing:.06em;
      text-transform:uppercase;
    }

    .theme-toggle--mobile {
      width:44px;
      height:44px;
      color:var(--ink) !important;
    }

    :global(body.menu-open) {
      overflow:hidden;
    }

    @media (prefers-reduced-motion: reduce) {
      .mobile-menu-panel,
      .mobile-menu-backdrop { transition-duration:0s; }
    }
  }
</style>
