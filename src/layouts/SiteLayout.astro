---
import CustomCursor from "../components/CustomCursor.astro";
import ContactFooter from "../components/ContactFooter.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active?: "home" | "works" | "about" | "blog";
}

const { title, description, active = "home" } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{title}</title>
    <script is:inline>
      const cursorMedia = matchMedia("(hover: hover) and (pointer: fine)");
      if (cursorMedia.matches) {
        document.documentElement.classList.add("custom-cursor-pending");
        window.setTimeout(() => {
          if (
            !document.documentElement.classList.contains("has-custom-cursor")
          ) {
            document.documentElement.classList.remove("custom-cursor-pending");
          }
        }, 2500);
      }

      const savedTheme = localStorage.getItem("sarah-theme");
      const theme =
        savedTheme ||
        (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
      document.documentElement.dataset.theme = theme;
    </script>
  </head>
  <body>
    <CustomCursor />

    <header
      class:list={{
        "site-header": true,
        "site-header--overlay": active === "home",
      }}
    >
      <a class="brand" href="/" aria-label="Sarah, página inicial">
        Sarah Heloísa
      </a>

      <nav class="nav" aria-label="Navegação principal">
        <a
          class:list={{ "desktop-link": true, "is-active": active === "home" }}
          href="/">Início</a
        >
        <a class:list={{ "primary-nav-link": true, "is-active": active === "works" }} href="/trabalhos"
          >Trabalhos</a
        >
        <a class:list={{ "primary-nav-link": true, "is-active": active === "about" }} href="/sobre"
          >Sobre</a
        >
        <a class:list={{ "primary-nav-link": true, "is-active": active === "blog" }} href="/blog">Blog</a>
        <a
          class="contact-link"
          href="#contato">Falar comigo</a
        >
        <details class="mobile-menu">
          <summary aria-label="Abrir menu">Menu</summary>
          <div>
            <a class:list={{ "is-active": active === "works" }} href="/trabalhos">Trabalhos</a>
            <a class:list={{ "is-active": active === "about" }} href="/sobre">Sobre</a>
            <a class:list={{ "is-active": active === "blog" }} href="/blog">Blog</a>
          </div>
        </details>
        <button class="theme-toggle" type="button" aria-label="Alternar tema">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"
              fill="currentColor"></path>
          </svg>
        </button>
      </nav>
    </header>

    <slot />
    <ContactFooter />

    <script is:inline>
      const setThemeColor = () => {
        const color = getComputedStyle(document.documentElement)
          .getPropertyValue("--paper")
          .trim();
        document
          .querySelector('meta[name="theme-color"]')
          ?.setAttribute("content", color);
      };
      setThemeColor();

      document.querySelector(".theme-toggle")?.addEventListener("click", () => {
        const next =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        localStorage.setItem("sarah-theme", next);
        setThemeColor();
      });

      const overlayHeader = document.querySelector(".site-header--overlay");
      if (overlayHeader) {
        const syncHeader = () => {
          overlayHeader.classList.toggle("is-scrolled", window.scrollY > 80);
        };
        syncHeader();
        window.addEventListener("scroll", syncHeader, { passive: true });
      }
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: 112px;
    padding: 18px clamp(18px, 2.5vw, 44px);
    background: var(--panel);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(14px);
  }

  .site-header--overlay {
    position: fixed;
    right: 0;
    left: 0;
    background: transparent;
    backdrop-filter: none;
    transition:
      background-color 280ms ease,
      border-color 280ms ease,
      box-shadow 280ms ease,
      backdrop-filter 280ms ease;
  }

  .site-header--overlay:not(.is-scrolled) {
    border-bottom-color: transparent;
    background-color: transparent !important;
    background-image: none !important;
    box-shadow: none;
    backdrop-filter: none;
  }

  .site-header--overlay.is-scrolled {
    border-bottom-color: var(--line);
    background: color-mix(in srgb, var(--paper) 91%, transparent);
    box-shadow: 0 10px 35px rgba(23, 23, 20, .06);
    backdrop-filter: blur(16px) saturate(120%);
  }

  .site-header--overlay:not(.is-scrolled) .brand,
  .site-header--overlay:not(.is-scrolled) .nav a,
  .site-header--overlay:not(.is-scrolled) .nav button,
  .site-header--overlay:not(.is-scrolled) .nav .is-active {
    color: var(--ink);
  }

  .site-header--overlay:not(.is-scrolled) .nav .contact-link {
    border-color: var(--ink);
  }

  .site-header--overlay:not(.is-scrolled) .theme-toggle {
    border-color: color-mix(in srgb, var(--ink) 28%, transparent) !important;
  }

  .brand {
    font-size: clamp(17px, 1.4vw, 23px);
    font-weight: 600;
    text-decoration: none;
    letter-spacing: -0.04em;
  }

  .brand small {
    display: block;
    margin-top: 3px;
    color: var(--muted);
    font:
      300 9px/1 "DM Mono",
      monospace;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .mark {
    width: 50px;
    color: var(--accent);
    transition: transform 450ms cubic-bezier(0.2, 0.75, 0.25, 1);
  }

  .mark:hover {
    transform: rotate(180deg);
  }

  .nav {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(13px, 1.7vw, 29px);
  }

  .nav button,
  .nav a {
    position: relative;
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: pointer;
    font:
      500 clamp(11px, 0.85vw, 14px)/1 "DM Mono",
      monospace;
    letter-spacing: -0.03em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .nav button::after,
  .nav a::after {
    position: absolute;
    right: 0;
    bottom: -4px;
    left: 0;
    height: 1px;
    background: currentColor;
    content: "";
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 250ms ease;
  }

  .nav button:hover::after,
  .nav a:hover::after,
  .nav a.is-active::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .nav .is-active {
    color: var(--ink);
  }

  .nav .contact-link {
    padding: 11px 15px;
    border: 1px solid var(--ink);
    border-radius: 999px;
    color: var(--ink);
    transition: background 200ms ease, color 200ms ease;
  }

  .nav .contact-link::after {
    display: none;
  }

  .nav .contact-link:hover,
  .nav .contact-link.is-active {
    background: var(--ink);
    color: var(--paper);
  }

  .site-header--overlay:not(.is-scrolled) .nav .contact-link:hover,
  .site-header--overlay:not(.is-scrolled) .nav .contact-link.is-active {
    background: var(--ink);
    color: var(--paper);
  }

  .theme-toggle {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border: 1px solid var(--line) !important;
    border-radius: 50%;
  }

  .mobile-menu {
    display: none;
  }

  .theme-toggle::after {
    display: none;
  }

  .theme-toggle svg {
    width: 14px;
    height: 14px;
  }

  @media (max-width: 760px) {
    .site-header {
      min-height: 78px;
      grid-template-columns: 1fr auto;
      padding: 12px 16px;
    }

    .brand small,
    .nav .desktop-link {
      display: none;
    }

    .nav {
      gap: 6px;
    }

    .nav .primary-nav-link {
      display: none;
    }

    .nav .contact-link {
      padding: 9px 11px;
    }

    .mobile-menu {
      position: relative;
      display: block;
    }

    .mobile-menu summary {
      padding: 9px 2px;
      color: var(--muted);
      cursor: pointer;
      font: 500 10px/1 "DM Mono", monospace;
      list-style: none;
      text-transform: uppercase;
    }

    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }

    .mobile-menu > div {
      position: absolute;
      z-index: 3;
      top: calc(100% + 14px);
      right: 0;
      display: grid;
      min-width: 160px;
      padding: 10px;
      border: 1px solid var(--line);
      background: var(--paper);
      box-shadow: 0 18px 44px rgba(0, 0, 0, .12);
    }

    .mobile-menu > div a {
      padding: 13px 10px;
    }
  }
</style>
