---
import { Image } from "astro:assets";
import type { HygraphAsset } from "../lib/hygraph";

interface Props {
  asset: HygraphAsset;
  alt: string;
  class?: string;
  maxWidth?: number;
  sizes?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  asset,
  alt,
  class: className,
  maxWidth = 1400,
  sizes = "100vw",
  loading = "lazy",
  fetchpriority = "auto",
} = Astro.props;

const sourceWidth = asset.width || maxWidth;
const sourceHeight = asset.height || Math.round(sourceWidth * 1.25);
const width = Math.min(sourceWidth, maxWidth);
const height = Math.round(sourceHeight * (width / sourceWidth));
const widths = [...new Set([360, 540, 760, 960, 1200, width])]
  .filter((candidate) => candidate <= width)
  .sort((a, b) => a - b);
---

<Image
  src={asset.url}
  alt={alt}
  class={className}
  width={width}
  height={height}
  widths={widths}
  sizes={sizes}
  format="webp"
  loading={loading}
  fetchpriority={fetchpriority}
  decoding="async"
/>
