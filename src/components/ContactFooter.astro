---
import { contactInfo } from "../lib/contact";

interface Props {
  name?: string;
  instagramHref?: string;
}

const {
  name = "Sarah Heloísa",
  instagramHref = contactInfo.instagramUrl,
} = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer" id="contato">
  <div>
    <p class="eyebrow">Vamos criar algo juntos</p>
    <a class="footer-email" href="/contato">Diga olá ↗</a>
  </div>
  <div class="footer-meta">
    <a href={instagramHref} target="_blank" rel="noreferrer">Instagram ↗</a><br />
    © {year} {name}
  </div>
</footer>

<style>
  .footer {
    display: flex;
    justify-content: space-between;
    align-items: end;
    min-height: 50vh;
    padding: clamp(70px, 8vw, 130px) clamp(20px, 5vw, 90px) 38px;
    background: var(--ink);
    color: var(--paper);
  }

  .footer a {
    text-decoration: none;
  }

  .footer-email {
    display: inline-block;
    border-bottom: 0.06em solid var(--accent);
    font-size: clamp(34px, 6.6vw, 106px);
    line-height: 0.95;
    letter-spacing: -0.065em;
  }

  .footer-meta {
    color: var(--muted);
    font: 400 9px/1.5 "DM Mono", monospace;
    text-align: right;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .footer {
      display: block;
      min-height: 55vh;
    }

    .footer-meta {
      margin-top: 110px;
      text-align: left;
    }
  }
</style>
