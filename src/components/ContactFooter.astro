---
import { contactInfo } from "../lib/contact";

interface Props {
  name?: string;
  instagramHref?: string;
  email?: string;
}

const {
  name = "Sarah Heloísa",
  instagramHref = contactInfo.instagramUrl,
  email = contactInfo.email,
} = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer" id="contato">
  <div class="footer-main">
    <p class="eyebrow-footer">Tem uma ideia em mente?</p>
    <h2>Vamos<br /><em>criar.</em></h2>
  </div>
  <div class="footer-meta">
    <div class="footer-links">
      {
        email && email !== "email@gmail.com" && (
          <a href={`mailto:${email}`}>
            <>
              <span>E-mail</span>
              <span aria-hidden="true">↗</span>
            </>
          </a>
        )
      }
      <a href={instagramHref} target="_blank" rel="noreferrer">
        <span>Instagram</span><span aria-hidden="true">↗</span>
      </a>
    </div>
    <span>© {year} {name}</span>
  </div>
</footer>

<style>
  .eyebrow-footer {
    font:
      400 16px/1.5 "DM Mono",
      monospace;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
  }

  .footer {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 70px;
    align-items: end;
    min-height: 64vh;
    padding: clamp(70px, 8vw, 130px) clamp(20px, 5vw, 90px) 38px;
    background: var(--ink);
    color: var(--paper);
  }

  .footer a {
    text-decoration: none;
  }

  .footer h2 {
    margin: clamp(45px, 7vw, 100px) 0;
    font-size: clamp(58px, 9vw, 142px);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: -0.08em;
  }

  .footer h2 em {
    color: var(--accent);
    font-style: normal;
  }

  .footer-meta {
    display: flex;
    min-width: clamp(230px, 17vw, 320px);
    min-height: 170px;
    flex-direction: column;
    justify-content: space-between;
    color: var(--muted);
    font:
      400 10px/1.5 "DM Mono",
      monospace;
    text-align: right;
    text-transform: uppercase;
  }

  .footer-links {
    display: grid;
    gap: 12px;
  }

  .footer-links a {
    display: flex;
    min-height: 58px;
    padding: 0 20px;
    align-items: center;
    justify-content: space-between;
    border: 1px solid color-mix(in srgb, var(--paper) 34%, transparent);
    border-radius: 999px;
    color: var(--paper);
    font-size: clamp(14px, 1.05vw, 19px);
    letter-spacing: -0.02em;
    transition:
      border-color 220ms ease,
      background 220ms ease,
      color 220ms ease,
      transform 220ms ease;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    border-color: var(--accent);
    background: var(--accent);
    color: #171714;
    transform: translateY(-2px);
  }

  @media (max-width: 760px) {
    .footer {
      display: block;
      min-height: 64vh;
    }

    .footer-meta {
      min-height: 0;
      margin-top: 90px;
      text-align: left;
    }

    .footer-links a {
      width: min(100%, 340px);
    }

    .footer-meta > span {
      display: block;
      margin-top: 38px;
      text-align: center;
    }
  }
</style>
