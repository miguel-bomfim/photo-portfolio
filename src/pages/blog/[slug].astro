---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getSiteData, type BlogPost } from "../../lib/hygraph";

export async function getStaticPaths() {
  const content = await getSiteData();
  return content.blogs.map((post, index) => ({
    params: { slug: post.slug },
    props: { post, nextPost: content.blogs[(index + 1) % content.blogs.length] },
  }));
}

interface Props { post: BlogPost; nextPost: BlogPost }
const { post, nextPost } = Astro.props;
const publishedDate = post.publishedAt
  ? new Intl.DateTimeFormat("pt-BR", { day: "2-digit", month: "long", year: "numeric" }).format(new Date(post.publishedAt))
  : null;
---

<SiteLayout title={post.seoTitle || `${post.title} — Sarah Heloísa`} description={post.seoDescription || post.excerpt} active="blog">
  <main>
    <article>
      <header class="article-head">
        <a class="back-link" href="/blog">← Voltar ao blog</a>
        <div class="article-meta"><span>{post.category || "Caderno"}</span>{publishedDate && <span>{publishedDate}</span>}</div>
        <h1>{post.title}</h1><p>{post.excerpt}</p>
      </header>
      {post.cover && <figure class="article-cover" data-cursor-photo><img src={post.cover.url} alt={`Capa de ${post.title}`} width={post.cover.width || 1600} height={post.cover.height || 1000} loading="eager" fetchpriority="high" /></figure>}
      <div class="article-body" set:html={post.content.html || ""} />
    </article>
    {nextPost && <a class="next-post" href={`/blog/${nextPost.slug}`} data-cursor-inverse><span class="eyebrow">Próxima publicação</span><strong>{nextPost.title} →</strong></a>}
  </main>
</SiteLayout>

<style>
  .article-head { position:relative; padding:clamp(70px,10vw,155px) clamp(18px,8vw,150px) clamp(65px,8vw,120px); }
  .back-link {
    position:relative;
    z-index:3;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:190px;
    min-height:48px;
    padding:0 20px;
    border:1px solid var(--ink);
    border-radius:999px;
    color:var(--ink);
    background:transparent;
    font:500 clamp(10px,.75vw,12px)/1 "DM Mono",monospace;
    text-decoration:none;
    text-transform:uppercase;
    cursor:pointer;
    pointer-events:auto;
    transition:background-color .25s ease,color .25s ease,transform .25s ease;
  }
  .back-link:hover,
  .back-link:focus-visible {
    background:var(--ink);
    color:var(--paper);
    transform:translateY(-2px);
  }
  .back-link:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
  .article-meta { display:flex; justify-content:space-between; margin:clamp(70px,8vw,120px) 0 30px; color:var(--muted); font:400 9px/1 "DM Mono",monospace; text-transform:uppercase; }
  .article-head h1 { max-width:1400px; margin:0; font-size:clamp(56px,9vw,145px); font-weight:500; line-height:.86; letter-spacing:-.08em; }
  .article-head>p { max-width:700px; margin:clamp(45px,6vw,90px) 0 0 auto; font-size:clamp(18px,1.7vw,27px); line-height:1.5; letter-spacing:-.035em; }
  .article-cover { height:min(82vh,950px); margin:0 var(--gutter); overflow:hidden; }
  .article-cover img { width:100%; height:100%; object-fit:cover; }
  .article-body { min-width:0; max-width:850px; margin:0 auto; padding:clamp(90px,12vw,185px) 24px; overflow-wrap:anywhere; font-size:clamp(17px,1.3vw,21px); line-height:1.8; }
  .article-body :global(p) { margin:0 0 1.6em; }
  .article-body :global(h2) { margin:2.4em 0 .8em; font-size:clamp(34px,4vw,58px); font-weight:500; line-height:1; letter-spacing:-.055em; }
  .article-body :global(h3) { margin:2.2em 0 .7em; font-size:1.45em; }
  .article-body :global(blockquote) { margin:2.5em 0; padding-left:30px; border-left:3px solid var(--accent); font-size:1.35em; line-height:1.5; }
  .article-body :global(img) { display:block; width:min(1200px,calc(100vw - 36px)); max-width:none; height:auto; margin:3em 0 3em 50%; transform:translateX(-50%); }
  .article-body :global(video), .article-body :global(iframe) { display:block; max-width:100%; margin:3em auto; }
  .article-body :global(pre), .article-body :global(table) { display:block; max-width:100%; overflow-x:auto; }
  .article-body :global(a) { text-underline-offset:5px; }
  .next-post { display:flex; min-height:55vh; padding:clamp(70px,9vw,140px) clamp(20px,5vw,90px); background:var(--ink); color:var(--paper); flex-direction:column; justify-content:space-between; text-decoration:none; }
  .next-post strong { max-width:1400px; font-size:clamp(48px,8vw,130px); font-weight:500; line-height:.88; letter-spacing:-.075em; }
  @media(max-width:760px){
    .article-head { padding-top:70px; }
    .article-head h1 { font-size:clamp(52px,16vw,72px); }
    .article-cover { height:auto; aspect-ratio:4/5; }
    .article-body { padding-right:18px; padding-left:18px; }
  }
</style>
