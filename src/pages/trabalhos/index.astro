---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getSiteData } from "../../lib/hygraph";

const content = await getSiteData();
const works = [
  ...content.professionalProjects.map((project) => ({
    id: project.id, title: project.title, slug: project.slug, category: "publicidade",
    cover: project.cover, meta: project.areas.join(" · ") || "Publicidade",
  })),
  ...content.portfolios.map((portfolio) => ({
    id: portfolio.id, title: portfolio.title, slug: portfolio.slug, category: "fotografia",
    cover: portfolio.portfolioThumbnail, meta: `${String(portfolio.photos.length).padStart(2, "0")} fotos`,
  })),
];

type CoverSize = "short" | "medium" | "tall";
const totalRows = Math.ceil(works.length / 3);
const coverSizes: CoverSize[] = works.map((_, index) => {
  const rowIndex = Math.floor(index / 3);
  const columnIndex = index % 3;
  if (rowIndex === totalRows - 1) return "medium";
  const descending: CoverSize[] = ["tall", "medium", "short"];
  const ascending: CoverSize[] = ["short", "medium", "tall"];
  return (rowIndex % 2 === 0 ? descending : ascending)[columnIndex];
});
---

<SiteLayout
  title="Trabalhos — Sarah Heloísa"
  description="Projetos de publicidade e fotografia de Sarah Heloísa."
  active="works"
>
  <main>
    <section class="page-intro" aria-labelledby="works-title">
      <h1 id="works-title">Ideias que<br />ganham forma.</h1>
      <div class="page-intro-copy">
        <p class="eyebrow">{works.length} trabalhos publicados</p>
        <p>Projetos construídos entre estratégia, conteúdo e imagem — da primeira intenção à forma final.</p>
      </div>
    </section>

    <nav class="filters" aria-label="Filtrar trabalhos">
      <button type="button" data-filter="todos" aria-pressed="true">Todos <span>{works.length}</span></button>
      <button type="button" data-filter="publicidade" aria-pressed="false">Publicidade <span>{content.professionalProjects.length}</span></button>
      <button type="button" data-filter="fotografia" aria-pressed="false">Fotografia <span>{content.portfolios.length}</span></button>
    </nav>

    <section class="works-grid" aria-label="Trabalhos" data-works-grid>
      {works.map((work, index) => (
        <a
          class:list={["work-card", `work-card--${coverSizes[index]}`]}
          href={`/trabalhos/${work.slug}`}
          data-category={work.category}
        >
          <div class="work-cover">
            <img src={work.cover.url} alt={`Capa de ${work.title}`} width={work.cover.width || 1200} height={work.cover.height || 1500} loading={index < 6 ? "eager" : "lazy"} fetchpriority={index < 2 ? "high" : "auto"} decoding="async" />
            <span>{work.category}</span>
          </div>
          <div class="work-info"><h2>{work.title}</h2><span>{work.meta} ↗</span></div>
        </a>
      ))}
    </section>
    <p class="empty-filter" data-empty-filter hidden>Nenhum projeto publicado nesta categoria ainda.</p>
  </main>
</SiteLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter]")];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-category]")];
  const empty = document.querySelector<HTMLElement>("[data-empty-filter]");
  const applyFilter = (filter: string) => {
    let visible = 0;
    cards.forEach((card) => {
      const show = filter === "todos" || card.dataset.category === filter;
      card.hidden = !show;
      if (show) visible += 1;
    });
    buttons.forEach((button) => button.setAttribute("aria-pressed", String(button.dataset.filter === filter)));
    if (empty) empty.hidden = visible > 0;
    const url = new URL(window.location.href);
    filter === "todos" ? url.searchParams.delete("filtro") : url.searchParams.set("filtro", filter);
    history.replaceState(null, "", url);
  };
  buttons.forEach((button) => button.addEventListener("click", () => applyFilter(button.dataset.filter || "todos")));
  const initial = new URLSearchParams(location.search).get("filtro");
  applyFilter(initial === "publicidade" || initial === "fotografia" ? initial : "todos");
</script>

<style>
  .page-intro { display:grid; grid-template-columns:1.25fr .75fr; gap:40px; align-items:end; padding:clamp(62px,10vw,160px) clamp(18px,3.5vw,64px) clamp(52px,7vw,100px); }
  .page-intro h1 { margin:0; font-size:clamp(58px,10vw,160px); font-weight:500; line-height:.82; letter-spacing:-.08em; }
  .page-intro-copy { max-width:430px; justify-self:end; }
  .page-intro-copy p:last-child { margin:0; font-size:clamp(14px,1.2vw,18px); line-height:1.55; }
  .filters { display:flex; gap:10px; padding:0 clamp(18px,3.5vw,64px) clamp(55px,7vw,100px); }
  .filters button { padding:12px 17px; border:1px solid var(--line); border-radius:999px; background:transparent; color:var(--muted); cursor:pointer; font:400 10px/1 "DM Mono",monospace; text-transform:uppercase; }
  .filters button[aria-pressed="true"] { border-color:var(--ink); background:var(--ink); color:var(--paper); }
  .filters span { margin-left:8px; opacity:.65; }
  .works-grid { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(28px,5vw,88px) var(--gutter); padding:0 var(--gutter) clamp(100px,12vw,180px); }
  .work-card { --cover-ratio:4/5; display:block; text-decoration:none; }
  .work-card[hidden] { display:none; }
  .work-card--tall { --cover-ratio:2/3; }
  .work-card--short { --cover-ratio:1/1; }
  .work-cover { position:relative; aspect-ratio:var(--cover-ratio); overflow:hidden; background:#c9c8c2; }
  .work-cover img { display:block; width:100%; height:100%; object-fit:cover; filter:grayscale(1); transition:filter 550ms ease,transform 650ms cubic-bezier(.2,.7,.2,1); }
  .work-card:hover .work-cover img,.work-card:focus-visible .work-cover img { filter:grayscale(0); transform:scale(1.035); }
  .work-cover>span { position:absolute; top:12px; left:12px; padding:8px 10px; background:rgba(20,20,18,.74); color:#fff; font:400 8px/1 "DM Mono",monospace; text-transform:uppercase; backdrop-filter:blur(8px); }
  .work-info { display:flex; justify-content:space-between; gap:20px; align-items:baseline; padding-top:13px; border-top:1px solid var(--line); }
  .work-info h2 { margin:0; font-size:clamp(19px,1.8vw,30px); font-weight:500; line-height:1.1; letter-spacing:-.045em; }
  .work-info span { color:var(--muted); font:400 9px/1 "DM Mono",monospace; white-space:nowrap; text-transform:uppercase; }
  .empty-filter { min-height:45vh; margin:0; padding:20px clamp(18px,3.5vw,64px); color:var(--muted); font:400 12px/1.5 "DM Mono",monospace; text-transform:uppercase; }
  @media(max-width:760px){
    .page-intro { display:block; padding-top:70px; }
    .page-intro h1 { margin-bottom:55px; }
    .page-intro-copy { width:78%; margin-left:auto; }
    .filters { gap:7px; overflow-x:auto; padding-bottom:55px; }
    .filters button { flex:none; }
    .works-grid { grid-template-columns:1fr 1fr; gap:44px var(--gutter); }
    .works-grid .work-card { --cover-ratio:4/5; }
    .work-info { display:block; }
    .work-info span { display:block; margin-top:8px; white-space:normal; }
  }
</style>
