---
import PhotoGallery, { type DisplayPhoto } from "../../components/PhotoGallery.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getSiteData, type Portfolio, type ProfessionalProject } from "../../lib/hygraph";

type NavigationWork = { title: string; slug: string };
type Props =
  | { kind: "fotografia"; work: Portfolio; previousWork: NavigationWork; nextWork: NavigationWork }
  | { kind: "publicidade"; work: ProfessionalProject; previousWork: NavigationWork; nextWork: NavigationWork };

export async function getStaticPaths() {
  const content = await getSiteData();
  const works = [
    ...content.professionalProjects.map((work) => ({ kind: "publicidade" as const, work })),
    ...content.portfolios.map((work) => ({ kind: "fotografia" as const, work })),
  ];
  return works.map((item, index) => ({
    params: { slug: item.work.slug },
    props: {
      ...item,
      previousWork: works[(index - 1 + works.length) % works.length].work,
      nextWork: works[(index + 1) % works.length].work,
    },
  }));
}

const { kind, work, previousWork, nextWork } = Astro.props as Props;
const isPhotography = kind === "fotografia";
const portfolio = isPhotography ? work as Portfolio : null;
const project = !isPhotography ? work as ProfessionalProject : null;
const assets = portfolio?.photos || project?.gallery || [];
const photos: DisplayPhoto[] = assets.map((asset, index) => ({
  id: asset.id || `${work.slug}-${index}`,
  title: work.title,
  label: String(index + 1).padStart(2, "0"),
  ratio: asset.width && asset.height ? `${asset.width} / ${asset.height}` : index % 3 === 0 ? "4 / 5" : "3 / 2",
  src: asset.url,
  width: asset.width || 1200,
  height: asset.height || 1500,
}));
const caseSections = project ? [
  { label: "Contexto", title: "O desafio", content: project.challenge },
  { label: "Pensamento", title: "A estratégia", content: project.strategy },
  { label: "Construção", title: "Da ideia à execução", content: project.execution },
  { label: "Impacto", title: "Resultados", content: project.results },
].filter((section) => section.content?.html || section.content?.text) : [];
---

<SiteLayout
  title={`${work.title} — Sarah Heloísa`}
  description={work.summary || `${isPhotography ? "Ensaio fotográfico" : "Projeto de publicidade"} ${work.title}, por Sarah Heloísa.`}
  active="works"
>
  <main>
    <section class="project-head" aria-labelledby="project-title">
      <div><a class="back-link" href="/trabalhos">← Todos os trabalhos</a><h1 id="project-title">{work.title}</h1></div>
      <div class="project-description">
        <p class="eyebrow">{isPhotography ? `${photos.length} fotografias` : project?.areas.join(" · ") || "Publicidade"}</p>
        <p>{work.summary || (isPhotography ? "Uma história contada em luz, presença e pequenos gestos." : "Uma ideia transformada em estratégia, linguagem e presença.")}</p>
      </div>
    </section>

    {project && (
      <>
        <figure class="case-cover" data-cursor-photo>
          <img src={project.cover.url} alt={`Capa do projeto ${project.title}`} width={project.cover.width || 1600} height={project.cover.height || 1000} loading="eager" fetchpriority="high" />
        </figure>
        <section class="case-facts" aria-label="Ficha do projeto">
          <div><span>Cliente</span><p>{project.client || "Projeto autoral"}</p></div>
          <div><span>Ano</span><p>{project.year || "—"}</p></div>
          <div><span>Atuação</span><p>{project.areas.join(" · ") || "Publicidade"}</p></div>
        </section>
        {caseSections.map((section, index) => (
          <section class:list={["case-section", { "case-section--inverse": index % 2 === 1 }]} data-cursor-inverse={index % 2 === 1 || undefined}>
            <div class="case-index"><p class="eyebrow">{section.label}</p><span>{String(index + 1).padStart(2, "0")}</span></div>
            <div><h2>{section.title}</h2>{section.content?.html ? <div class="rich-text" set:html={section.content.html} /> : <p class="rich-text">{section.content?.text}</p>}</div>
          </section>
        ))}
      </>
    )}

    {photos.length > 0 && <PhotoGallery photos={photos} id={work.slug} eagerCount={6} />}

    {previousWork && nextWork && (
      <nav class="project-navigation" aria-label="Navegação entre trabalhos">
        <a class="project-link" href={`/trabalhos/${previousWork.slug}`}><span class="eyebrow">Trabalho anterior</span><strong>← {previousWork.title}</strong></a>
        <a class="project-link project-link--next" href={`/trabalhos/${nextWork.slug}`}><span class="eyebrow">Próximo trabalho</span><strong>{nextWork.title} →</strong></a>
      </nav>
    )}
  </main>
</SiteLayout>

<style>
  .project-head { display:grid; grid-template-columns:1.2fr .8fr; gap:40px; align-items:end; min-height:54vh; padding:clamp(55px,9vw,140px) clamp(18px,3.5vw,64px) clamp(50px,7vw,100px); }
  .project-head > div:first-child { position:relative; z-index:2; }
  .project-head h1 { margin:0; font-size:clamp(58px,10vw,155px); font-weight:500; line-height:.84; letter-spacing:-.08em; }
  .project-description { max-width:540px; justify-self:end; }
  .project-description p:last-child { margin:0; white-space:pre-line; font-size:clamp(14px,1.15vw,17px); line-height:1.6; }
  .back-link {
    position:relative;
    z-index:3;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    min-width:190px;
    min-height:48px;
    margin-bottom:clamp(28px,3vw,46px);
    padding:0 20px;
    border:1px solid var(--ink);
    border-radius:999px;
    color:var(--ink);
    background:transparent;
    font:500 clamp(10px,.75vw,12px)/1 "DM Mono",monospace;
    text-decoration:none;
    text-transform:uppercase;
    cursor:pointer;
    pointer-events:auto;
    transition:background-color .25s ease,color .25s ease,transform .25s ease;
  }
  .back-link:hover,
  .back-link:focus-visible {
    background:var(--ink);
    color:var(--paper);
    transform:translateY(-2px);
  }
  .back-link:focus-visible { outline:2px solid var(--accent); outline-offset:4px; }
  .case-cover { margin:0 var(--gutter); height:min(82vh,980px); overflow:hidden; background:#c9c8c2; }
  .case-cover img { width:100%; height:100%; object-fit:cover; }
  .case-facts { display:grid; grid-template-columns:repeat(3,1fr); border-bottom:1px solid var(--line); }
  .case-facts>div { min-height:220px; padding:34px clamp(20px,4vw,64px); border-right:1px solid var(--line); }
  .case-facts>div:last-child { border:0; }
  .case-facts span,.case-index>span { color:var(--muted); font:400 9px/1.4 "DM Mono",monospace; text-transform:uppercase; }
  .case-facts p { margin:80px 0 0; font-size:clamp(16px,1.4vw,22px); }
  .case-section { display:grid; grid-template-columns:.5fr 1.5fr; gap:clamp(40px,8vw,150px); min-height:75vh; padding:clamp(95px,12vw,190px) clamp(20px,5vw,90px); }
  .case-section--inverse { background:var(--ink); color:var(--paper); }
  .case-index { display:flex; flex-direction:column; justify-content:space-between; }
  .case-section h2 { max-width:950px; margin:0 0 clamp(60px,8vw,120px); font-size:clamp(48px,7.5vw,120px); font-weight:500; line-height:.9; letter-spacing:-.075em; }
  .rich-text { max-width:820px; font-size:clamp(16px,1.3vw,20px); line-height:1.75; }
  .rich-text :global(h2),.rich-text :global(h3) { margin:2.2em 0 .7em; font-size:1.5em; line-height:1.2; }
  .rich-text :global(a) { text-underline-offset:4px; }
  .project-navigation { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); border-top:1px solid var(--line); }
  .project-link { display:flex; min-width:0; padding:clamp(64px,9vw,132px) clamp(20px,5vw,90px); flex-direction:column; gap:22px; text-decoration:none; }
  .project-link:hover { background:var(--line); }
  .project-link--next { align-items:flex-end; border-left:1px solid var(--line); text-align:right; }
  .project-link .eyebrow { margin:0; }
  .project-link strong { font-size:clamp(32px,3vw,94px); font-weight:400; line-height:.95; letter-spacing:-.065em; overflow-wrap:anywhere; }
  @media(max-width:760px){
    .project-head { display:block; min-height:auto; padding-top:70px; }
    .project-head h1 { margin-bottom:55px; }
    .project-description { width:78%; margin-left:auto; }
    .case-cover { height:auto; aspect-ratio:4/5; }
    .case-facts { grid-template-columns:1fr; }
    .case-facts>div { min-height:180px; border-right:0; border-bottom:1px solid var(--line); }
    .case-facts p { margin-top:65px; }
    .case-section { display:block; min-height:auto; padding:95px 18px; }
    .case-index { margin-bottom:70px; }
    .case-index>span { display:none; }
    .project-navigation { grid-template-columns:1fr; }
    .project-link { padding:52px 18px; }
    .project-link--next { border-top:1px solid var(--line); border-left:0; }
  }
</style>
