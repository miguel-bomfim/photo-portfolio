---
import PhotoGallery, { type DisplayPhoto } from "../components/PhotoGallery.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSiteData } from "../lib/hygraph";

const content = await getSiteData();
const home = content.homePages[0];
const about = content.aboutMes[0];

const assetContext = new Map(
  content.portfolios.flatMap((portfolio) =>
    portfolio.photos.map((asset) => [
      asset.id || asset.url,
      { title: portfolio.title, slug: portfolio.slug },
    ] as const),
  ),
);

const selectedAssets =
  home?.portfolioThumbnail.length > 0
    ? home.portfolioThumbnail
    : content.portfolios.map((portfolio) => portfolio.portfolioThumbnail);

const photos: DisplayPhoto[] = selectedAssets.map((asset, index) => {
  const context = assetContext.get(asset.id || asset.url);
  return {
    id: asset.id || `home-${index}`,
    title: context?.title || "Seleção Sarah",
    label: String(index + 1).padStart(2, "0"),
    ratio:
      asset.width && asset.height
        ? `${asset.width} / ${asset.height}`
        : index % 3 === 0
          ? "4 / 5"
          : "3 / 2",
    src: asset.url,
    width: asset.width || 1200,
    height: asset.height || 1500,
  };
});

const aboutLead =
  about?.summary.text.split("\n").find(Boolean) ||
  home?.spoilerText ||
  "Fotografia feita de presença, espontaneidade e histórias reais.";
---
<SiteLayout
  title={`${home?.title || "Sarah Heloísa"} — Fotografia`}
  description={home?.bannerText || "Portfólio de Sarah Heloísa."}
  active="home"
>
  <main id="top">
    <section class="intro" aria-labelledby="intro-title">
      <h1 id="intro-title">Memória, registro<br />e <em>história.</em></h1>
      <div class="intro-copy">
        <p class="eyebrow">Seleção da fotógrafa · {photos.length} imagens</p>
        <p>{home?.bannerText || "Experiências memoráveis eternizadas em fotos."}</p>
      </div>
    </section>

    <PhotoGallery photos={photos} id="selecionadas" shuffle />

    <section class="about" id="sobre" aria-labelledby="about-title">
      <div>
        <p class="eyebrow">Sobre</p>
        <h2 id="about-title">Olhar<br />atento.</h2>
      </div>
      <div class="about-copy">
        <p>{aboutLead}</p>
        <dl class="details">
          <div>
            <dt>Base</dt>
            <dd>Brasil<br />Disponível para viajar</dd>
          </div>
          <div>
            <dt>Trabalho</dt>
            <dd>Retrato<br />Editorial · Lifestyle</dd>
          </div>
          <div>
            <dt>Portfólio</dt>
            <dd>{content.portfolios.length} histórias<br /><a href="/trabalhos">Ver todos ↗</a></dd>
          </div>
        </dl>
      </div>
    </section>
  </main>

  <footer class="footer" id="contato">
    <div>
      <p class="eyebrow">Vamos criar algo juntos</p>
      <a class="footer-email" href="mailto:ola@sarahfoto.com">Diga olá ↗</a>
    </div>
    <div class="footer-meta">
      <a href="#" rel="noreferrer">Instagram ↗</a><br />
      © 2026 {about?.name || home?.title || "Sarah Fotografia"}
    </div>
  </footer>
</SiteLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(240px, .8fr);
    gap: 30px;
    align-items: end;
    padding: clamp(42px, 7vw, 110px) clamp(18px, 3.5vw, 64px) clamp(38px, 5vw, 72px);
  }

  .intro h1 {
    max-width: 920px;
    margin: 0;
    font-size: clamp(50px, 8.4vw, 142px);
    font-weight: 500;
    line-height: .82;
    letter-spacing: -.075em;
  }

  .intro h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .intro-copy {
    max-width: 420px;
    justify-self: end;
  }

  .intro-copy p:last-child {
    margin: 0;
    font-size: clamp(14px, 1.2vw, 18px);
    line-height: 1.5;
    letter-spacing: -.025em;
  }

  .about {
    display: grid;
    grid-template-columns: .7fr 1.3fr;
    gap: clamp(30px, 8vw, 150px);
    min-height: 75vh;
    padding: clamp(90px, 12vw, 190px) clamp(20px, 5vw, 90px);
    border-top: 1px solid var(--line);
  }

  .about h2 {
    margin: 0;
    font-size: clamp(42px, 7vw, 110px);
    font-weight: 500;
    line-height: .9;
    letter-spacing: -.07em;
  }

  .about-copy {
    max-width: 810px;
  }

  .about-copy > p {
    margin: 0 0 42px;
    font-size: clamp(24px, 3.2vw, 51px);
    line-height: 1.12;
    letter-spacing: -.055em;
  }

  .details {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .details dt {
    margin-bottom: 8px;
    color: var(--muted);
    font: 400 9px/1 "DM Mono", monospace;
    text-transform: uppercase;
  }

  .details dd {
    margin: 0;
    font-size: 13px;
    line-height: 1.5;
  }

  .footer {
    display: flex;
    justify-content: space-between;
    align-items: end;
    min-height: 50vh;
    padding: clamp(70px, 8vw, 130px) clamp(20px, 5vw, 90px) 38px;
    background: var(--ink);
    color: var(--paper);
  }

  .footer a {
    text-decoration: none;
  }

  .footer-email {
    display: inline-block;
    font-size: clamp(34px, 6.6vw, 106px);
    line-height: .95;
    letter-spacing: -.065em;
    border-bottom: .06em solid var(--accent);
  }

  .footer-meta {
    color: var(--muted);
    font: 400 9px/1.5 "DM Mono", monospace;
    text-align: right;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .intro {
      display: block;
      padding-top: 62px;
    }

    .intro h1 {
      margin-bottom: 45px;
    }

    .intro-copy {
      width: 78%;
      margin-left: auto;
    }

    .about {
      display: block;
    }

    .about h2 {
      margin-bottom: 64px;
    }

    .details {
      grid-template-columns: 1fr;
    }

    .footer {
      display: block;
      min-height: 55vh;
    }

    .footer-meta {
      margin-top: 110px;
      text-align: left;
    }
  }
</style>
