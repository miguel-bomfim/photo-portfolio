---
import CmsImage from "../components/CmsImage.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSiteData } from "../lib/hygraph";
import "../styles/pages/home.css";

const content = await getSiteData();
const home = content.homePages[0];
const about = content.aboutMes[0];

const recentPosts = content.blogs.slice(0, 3);
const featuredCase = content.professionalProjects.find(
  (project) => project.featured,
);
const clientNames = [
  ...new Set(
    content.professionalProjects
      .map((project) => project.client?.trim())
      .filter(Boolean),
  ),
] as string[];

const heroAsset =
  home?.homeBackground ||
  about?.photo ||
  home?.portfolioThumbnail.find(
    (asset) => (asset.width || 0) > (asset.height || 1) * 1.18,
  ) ||
  home?.portfolioThumbnail[0] ||
  content.portfolios[0]?.portfolioThumbnail;
const publicityAsset = content.professionalProjects[0]?.cover || heroAsset;
const photographyAsset =
  content.portfolios.find(
    (portfolio) => !/vinil|auto-retrato/i.test(portfolio.slug),
  )?.portfolioThumbnail ||
  content.portfolios[0]?.portfolioThumbnail ||
  heroAsset;
const aboutText =
  about?.shortBio ||
  "Publicitária e fotógrafa. Estratégia e sensibilidade para transformar ideias em narrativas que encontram as pessoas.";
---

<SiteLayout
  title={`${home?.title || "Sarah Heloísa"} — Publicidade e fotografia em Santa Catarina`}
  description="Publicitária e fotógrafa em Santa Catarina. Estratégia, conteúdo e imagem para marcas e pessoas."
  active="home"
>
  <main id="top">
    <section class="hero" aria-labelledby="hero-title">
      {
        heroAsset && (
          <figure class="hero-visual" data-cursor-photo>
            <img
              src={heroAsset.url}
              width={heroAsset.width || 800}
              height={heroAsset.height || 450}
              alt="Sarah Heloísa na praia"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        )
      }

      <div class="hero-copy">
        <h1 id="hero-title">
          Estratégia e imagem para <em>marcas e pessoas.</em>
        </h1>
        <div class="hero-actions">
          <a class="button button--primary" href="/trabalhos">Ver trabalhos</a>
          <a class="button" href="#contato">Falar comigo</a>
        </div>
      </div>
    </section>

    <section class="paths" aria-labelledby="paths-title">
      <header class="section-heading section-heading--compact">
        <p class="eyebrow">Por onde começar</p>
        <h2 id="paths-title">
          Duas formas de dar<br /><em>presença a uma ideia.</em>
        </h2>
      </header>
      <div class="path-grid">
        <a
          class="path-card"
          href="/trabalhos?filtro=publicidade"
          data-cursor-photo
        >
          {
            publicityAsset && (
              <CmsImage
                asset={publicityAsset}
                alt="Projeto de publicidade de Sarah Heloísa"
                maxWidth={1100}
                sizes="(max-width: 760px) 100vw, 50vw"
              />
            )
          }
          <span class="path-shade" aria-hidden="true"></span>
          <span class="path-index">Para marcas</span>
          <span class="path-copy"
            ><strong>Publicidade</strong><span
              >Estratégia, planejamento e conteúdo ↗</span
            ></span
          >
        </a>
        <a
          class="path-card"
          href="/trabalhos?filtro=fotografia"
          data-cursor-photo
        >
          {
            photographyAsset && (
              <CmsImage
                asset={photographyAsset}
                alt="Ensaio fotográfico de Sarah Heloísa"
                maxWidth={1100}
                sizes="(max-width: 760px) 100vw, 50vw"
              />
            )
          }
          <span class="path-shade" aria-hidden="true"></span>
          <span class="path-index">Para pessoas</span>
          <span class="path-copy"
            ><strong>Fotografia</strong><span
              >Retratos, narrativas e presença ↗</span
            ></span
          >
        </a>
      </div>
      <div class="all-works-action">
        <a class="all-works-cta" href="/trabalhos">
          <span>Ver todos os trabalhos</span><span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    {
      featuredCase && (
        <section
          class="case-study"
          aria-labelledby="case-title"
          data-cursor-inverse
        >
          <div class="case-copy">
            <p class="eyebrow">Estudo de caso em destaque</p>
            <h2 id="case-title">{featuredCase.title}</h2>
            <p>{featuredCase.summary}</p>
            <dl>
              {featuredCase.client && (
                <div>
                  <dt>Cliente</dt>
                  <dd>{featuredCase.client}</dd>
                </div>
              )}
              {featuredCase.year && (
                <div>
                  <dt>Ano</dt>
                  <dd>{featuredCase.year}</dd>
                </div>
              )}
              <div>
                <>
                  <dt>Atuação</dt>
                  <dd>{featuredCase.areas.join(" · ")}</dd>
                </>
              </div>
            </dl>
            <a
              class="button button--light"
              href={`/trabalhos/${featuredCase.slug}`}
            >
              Conhecer o projeto ↗
            </a>
          </div>
          <div class="case-image" data-cursor-photo>
            <CmsImage
              asset={featuredCase.cover}
              alt={`Estudo de caso ${featuredCase.title}`}
              maxWidth={1400}
              sizes="(max-width: 760px) 100vw, 50vw"
            />
          </div>
        </section>
      )
    }

    {
      clientNames.length > 0 && (
        <section class="clients" aria-labelledby="clients-title">
          <p class="eyebrow" id="clients-title">
            Clientes e projetos
          </p>
          <div class="client-list">
            {clientNames.map((client) => (
              <span>{client}</span>
            ))}
          </div>
        </section>
      )
    }

    <section class="about-preview" aria-labelledby="about-preview-title">
      {
        about?.photo && (
          <div class="about-preview-image" data-cursor-photo>
            <CmsImage
              asset={about.photo}
              alt={`Retrato de ${about.name || "Sarah Heloísa"}`}
              maxWidth={900}
              sizes="(max-width: 760px) 100vw, 40vw"
            />
          </div>
        )
      }
      <div class="about-preview-copy">
        <h2 id="about-preview-title">
          Olhar atento,<br /><em>ideias com direção.</em>
        </h2>
        <p>{aboutText}</p>
        <a href="/sobre">Conhecer a Sarah ↗</a>
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section class="journal" aria-labelledby="journal-title">
          <header class="section-heading">
            <p class="eyebrow">Blog</p>
            <h2 id="journal-title">
              Ideias, referências
              <br />e <em>processos.</em>
            </h2>
            <a href="/blog">Ver todos os posts ↗</a>
          </header>
          <div class="journal-grid">
            {recentPosts.map((post) => (
              <a class="post-card" href={`/blog/${post.slug}`}>
                {post.cover && (
                  <div class="post-cover" data-cursor-photo>
                    <CmsImage
                      asset={post.cover}
                      alt={`Capa do post ${post.title}`}
                      maxWidth={900}
                      sizes="(max-width: 760px) 100vw, 33vw"
                    />
                  </div>
                )}
                <span>{post.category || "Caderno"}</span>
                <h3>{post.title}</h3>
                <p>{post.excerpt}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>
</SiteLayout>
