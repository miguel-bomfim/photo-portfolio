---
import PhotoGallery, {
  type DisplayPhoto,
} from "../components/PhotoGallery.astro";
import ContactFooter from "../components/ContactFooter.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSiteData } from "../lib/hygraph";

const content = await getSiteData();
const home = content.homePages[0];
const about = content.aboutMes[0];

const assetContext = new Map(
  content.portfolios.flatMap((portfolio) =>
    portfolio.photos.map(
      (asset) =>
        [
          asset.id || asset.url,
          { title: portfolio.title, slug: portfolio.slug },
        ] as const,
    ),
  ),
);

const selectedAssets =
  home?.portfolioThumbnail.length > 0
    ? home.portfolioThumbnail
    : content.portfolios.map((portfolio) => portfolio.portfolioThumbnail);

const photos: DisplayPhoto[] = selectedAssets.map((asset, index) => {
  const context = assetContext.get(asset.id || asset.url);
  return {
    id: asset.id || `home-${index}`,
    title: context?.title || "Seleção Sarah",
    label: String(index + 1).padStart(2, "0"),
    ratio:
      asset.width && asset.height
        ? `${asset.width} / ${asset.height}`
        : index % 3 === 0
          ? "4 / 5"
          : "3 / 2",
    src: asset.url,
    width: asset.width || 1200,
    height: asset.height || 1500,
  };
});

---

<SiteLayout
  title={`${home?.title || "Sarah Heloísa"} — Fotografia`}
  description={home?.bannerText || "Portfólio de Sarah Heloísa."}
  active="home"
>
  <main id="top">
    <section class="intro" aria-labelledby="intro-title">
      <h1 id="intro-title">Memória, registro<br />e <em>história.</em></h1>
      <div class="intro-copy">
        <p class="eyebrow">Seleção da fotógrafa · {photos.length} imagens</p>
        <p>
          {home?.bannerText || "Experiências memoráveis eternizadas em fotos."}
        </p>
      </div>
    </section>

    <PhotoGallery photos={photos} id="selecionadas" shuffle />
  </main>

  <ContactFooter name={about?.name || home?.title || "Sarah Fotografia"} />
</SiteLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(240px, 0.8fr);
    gap: 30px;
    align-items: end;
    padding: clamp(42px, 7vw, 110px) clamp(18px, 3.5vw, 64px)
      clamp(38px, 5vw, 72px);
  }

  .intro h1 {
    max-width: 920px;
    margin: 0;
    font-size: clamp(50px, 8.4vw, 142px);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: -0.075em;
  }

  .intro h1 em {
    color: var(--accent);
    font-style: normal;
  }

  .intro-copy {
    max-width: 420px;
    justify-self: end;
  }

  .intro-copy p:last-child {
    margin: 0;
    font-size: clamp(14px, 1.2vw, 18px);
    line-height: 1.5;
    letter-spacing: -0.025em;
  }

  @media (max-width: 760px) {
    .intro {
      display: block;
      padding-top: 62px;
    }

    .intro h1 {
      margin-bottom: 45px;
    }

    .intro-copy {
      width: 78%;
      margin-left: auto;
    }

  }
</style>
