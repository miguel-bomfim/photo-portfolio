---
import PhotoGallery, {
  type DisplayPhoto,
} from "../components/PhotoGallery.astro";
import ContactFooter from "../components/ContactFooter.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { getSiteData } from "../lib/hygraph";

const content = await getSiteData();
const home = content.homePages[0];
const about = content.aboutMes[0];
const featuredProjects = content.professionalProjects
  .filter((project) => project.featured)
  .slice(0, 3);
const recentPosts = content.blogs.slice(0, 3);

const assetContext = new Map(
  content.portfolios.flatMap((portfolio) =>
    portfolio.photos.map(
      (asset) => [asset.id || asset.url, { title: portfolio.title }] as const,
    ),
  ),
);
const selectedAssets =
  home?.portfolioThumbnail.length > 0
    ? home.portfolioThumbnail
    : content.portfolios.map((portfolio) => portfolio.portfolioThumbnail);
const photos: DisplayPhoto[] = selectedAssets.map((asset, index) => ({
  id: asset.id || `home-${index}`,
  title: assetContext.get(asset.id || asset.url)?.title || "Seleção Sarah",
  label: String(index + 1).padStart(2, "0"),
  ratio:
    asset.width && asset.height
      ? `${asset.width} / ${asset.height}`
      : index % 3 === 0
        ? "4 / 5"
        : "3 / 2",
  src: asset.url,
  width: asset.width || 1200,
  height: asset.height || 1500,
}));
---

<SiteLayout
  title={`${home?.title || "Sarah Heloísa"} — Publicidade, social media e fotografia`}
  description={home?.heroText ||
    "Portfólio profissional de Sarah Heloísa: publicidade, social media e fotografia."}
  active="home"
>
  <main id="top">
    <section class="intro" aria-labelledby="intro-title">
      <div class="intro-heading">
        <h1 id="intro-title">
          {
            home?.heroTitle || (
              <>
                Estratégia,
                <br />
                conteúdo e <em>imagem.</em>
              </>
            )
          }
        </h1>
      </div>
      <div class="intro-copy">
        <p>
          {
            home?.heroText ||
              "Ideias ganham forma quando intenção, linguagem e olhar caminham juntos. Crio presença para marcas e histórias através da publicidade, do social media e da fotografia."
          }
        </p>
        <a href="/sobre">Conheça minha trajetória ↗</a>
      </div>
    </section>

    <section class="disciplines" aria-label="Áreas de atuação">
      <div>
        <span>Publicidade</span><p>Conceito, campanha e direção criativa.</p>
      </div>
      <div>
        <span>Social media</span><p>Estratégia, planejamento e conteúdo.</p>
      </div>
      <div><span>Fotografia</span><p>Retratos, narrativas e presença.</p></div>
    </section>

    {
      featuredProjects.length > 0 && (
        <section class="featured" aria-labelledby="featured-title">
          <header class="section-heading">
            <p class="eyebrow">Publicidade selecionada</p>
            <h2 id="featured-title">
              Projetos com
              <br />
              ideia e direção.
            </h2>
            <a href="/trabalhos?filtro=publicidade">Ver publicidade ↗</a>
          </header>
          <div class="featured-grid">
            {featuredProjects.map((project, index) => (
              <a class="featured-card" href={`/trabalhos/${project.slug}`}>
                <img
                  src={project.cover.url}
                  alt={`Capa do projeto ${project.title}`}
                  width={project.cover.width || 1400}
                  height={project.cover.height || 1000}
                  loading={index === 0 ? "eager" : "lazy"}
                />
                <div>
                  <h3>{project.title}</h3>
                  <span>{project.areas.join(" · ")} ↗</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="photography-heading" aria-labelledby="photography-title">
      <div>
        <p class="eyebrow">Fotografia selecionada · {photos.length} imagens</p>
        <h2 id="photography-title">Histórias que<br /><em>permanecem.</em></h2>
      </div>
      <p>
        {
          home?.bannerText ||
            "Uma seleção de experiências, encontros e pequenos gestos eternizados em imagens."
        }
      </p>
    </section>
    <PhotoGallery photos={photos} id="selecionadas" shuffle />

    {
      recentPosts.length > 0 && (
        <section class="journal" aria-labelledby="journal-title">
          <header class="section-heading">
            <p class="eyebrow">Blog</p>
            <h2 id="journal-title">
              Notas sobre
              <br />o processo.
            </h2>
          </header>
          <div class="journal-list">
            {recentPosts.map((post) => (
              <a href={`/blog/${post.slug}`}>
                <span>{post.category || "Caderno"}</span>
                <h3>{post.title}</h3>
                <span>Leia ↗</span>
              </a>
            ))}
          </div>
        </section>
      )
    }
  </main>
  <ContactFooter name={about?.name || home?.title || "Sarah Heloísa"} />
</SiteLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    gap: 50px;
    align-items: end;
    min-height: calc(78svh - 112px);
    padding: clamp(28px, 3.5vw, 54px) clamp(18px, 3.5vw, 64px);
  }
  .intro-heading h1 {
    margin: clamp(36px, 5vw, 72px) 0 0;
    font-size: clamp(62px, 10vw, 160px);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: -0.08em;
  }
  .intro-heading em,
  .photography-heading em {
    color: var(--accent);
    font-style: normal;
  }
  .intro-copy {
    max-width: 520px;
    justify-self: end;
  }
  .intro-copy p {
    margin: 0 0 40px;
    font-size: clamp(18px, 1.65vw, 26px);
    line-height: 1.45;
    letter-spacing: -0.04em;
  }
  .intro-copy a,
  .section-heading a {
    font:
      400 10px/1 "DM Mono",
      monospace;
    text-transform: uppercase;
    text-underline-offset: 5px;
  }
  .disciplines {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .disciplines > div {
    min-height: 230px;
    padding: 34px clamp(20px, 4vw, 64px);
    border-right: 1px solid var(--line);
  }
  .disciplines > div:last-child {
    border: 0;
  }
  .disciplines span {
    color: var(--muted);
    font:
      400 10px/1 "DM Mono",
      monospace;
    text-transform: uppercase;
  }
  .disciplines p {
    margin: clamp(65px, 8vw, 105px) 0 0;
    font-size: clamp(17px, 1.5vw, 23px);
  }
  .featured,
  .journal {
    padding: clamp(100px, 13vw, 200px) clamp(18px, 3.5vw, 64px);
  }
  .section-heading {
    display: grid;
    grid-template-columns: 0.45fr 1fr auto;
    gap: 35px;
    align-items: end;
    margin-bottom: clamp(60px, 8vw, 120px);
  }
  .section-heading h2,
  .photography-heading h2 {
    margin: 0;
    font-size: clamp(48px, 7.8vw, 124px);
    font-weight: 500;
    line-height: 0.88;
    letter-spacing: -0.075em;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gutter);
  }
  .featured-card {
    text-decoration: none;
  }
  .featured-card img {
    display: block;
    width: 100%;
    aspect-ratio: 4/5;
    object-fit: cover;
    filter: grayscale(0.85);
    transition:
      filter 450ms ease,
      transform 600ms ease;
  }
  .featured-card:hover img {
    filter: none;
    transform: scale(0.985);
  }
  .featured-card > div {
    display: flex;
    justify-content: space-between;
    gap: 15px;
    padding-top: 14px;
    border-top: 1px solid var(--line);
  }
  .featured-card h3 {
    margin: 0;
    font-size: clamp(19px, 1.8vw, 29px);
    font-weight: 500;
  }
  .featured-card span,
  .journal-list span {
    color: var(--muted);
    font:
      400 9px/1.4 "DM Mono",
      monospace;
    text-transform: uppercase;
  }
  .photography-heading {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: 40px;
    align-items: end;
    padding: clamp(100px, 13vw, 190px) clamp(18px, 3.5vw, 64px)
      clamp(55px, 7vw, 105px);
  }
  .photography-heading > p {
    max-width: 440px;
    margin: 0;
    justify-self: end;
    font-size: clamp(15px, 1.2vw, 19px);
    line-height: 1.6;
  }
  .journal {
    border-top: 1px solid var(--line);
  }
  .journal-list {
    border-top: 1px solid var(--line);
  }
  .journal-list a {
    display: grid;
    grid-template-columns: 0.35fr 1fr auto;
    gap: 25px;
    align-items: center;
    min-height: 150px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }
  .journal-list h3 {
    margin: 0;
    font-size: clamp(26px, 3vw, 48px);
    font-weight: 500;
    letter-spacing: -0.05em;
  }
  @media (max-width: 760px) {
    .intro {
      display: block;
      min-height: auto;
      padding-top: 44px;
    }
    .intro-heading h1 {
      margin: 52px 0;
      font-size: clamp(57px, 18vw, 78px);
    }
    .intro-copy {
      width: 82%;
      margin-left: auto;
    }
    .disciplines {
      grid-template-columns: 1fr;
    }
    .disciplines > div {
      min-height: 190px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .section-heading,
    .photography-heading {
      display: block;
    }
    .section-heading h2,
    .photography-heading h2 {
      margin: 38px 0;
    }
    .featured-grid {
      grid-template-columns: 1fr;
      gap: 55px;
    }
    .photography-heading > p {
      width: 78%;
      margin-left: auto;
    }
    .journal-list a {
      grid-template-columns: 1fr auto;
      padding: 28px 0;
    }
    .journal-list a > span:first-child {
      grid-column: 1/-1;
    }
  }
</style>
