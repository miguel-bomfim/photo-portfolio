---
import SiteLayout from "../layouts/SiteLayout.astro";
import { contactInfo } from "../lib/contact";
import { getSiteData } from "../lib/hygraph";

const content = await getSiteData();
const settings = content.siteSettings;
const contact = {
  email: settings?.email || contactInfo.email,
  instagramUrl: settings?.instagramUrl || contactInfo.instagramUrl,
  instagramLabel: settings?.instagramHandle || contactInfo.instagramLabel,
  location: settings?.location || contactInfo.location,
  responseTime: settings?.responseTime || contactInfo.responseTime,
};
---

<SiteLayout
  title="Contato — Sarah Heloísa"
  description="Entre em contato com Sarah Heloísa para conversar sobre publicidade, social media e fotografia."
  active="contact"
>
  <main class="contact-page">
    <section class="contact-hero" aria-labelledby="contact-title">
      <div class="contact-intro">
        <p class="eyebrow">Contato</p>
        <h1 id="contact-title">Vamos<br />conversar<span>?</span></h1>
      </div>

      <div class="contact-note">
        <p>
          Conte um pouco sobre a sua ideia, marca ou história. Responderei com
          calma para entender o contexto e pensar no melhor caminho.
        </p>
        <span>Publicidade · Social media · Fotografia</span>
      </div>

      <div class="contact-at" aria-hidden="true">@</div>
    </section>

    <section class="contact-channels" aria-label="Canais de contato">
      <a class="channel" href={`mailto:${contact.email}`}>
        <span class="channel-label">E-mail</span>
        <strong>{contact.email}</strong>
        <span class="channel-arrow" aria-hidden="true">↗</span>
      </a>

      <a
        class="channel"
        href={contact.instagramUrl}
        target="_blank"
        rel="noreferrer"
        aria-label="Abrir Instagram em uma nova aba"
      >
        <span class="channel-label">Instagram</span>
        <strong>{contact.instagramLabel}</strong>
        <span class="channel-arrow" aria-hidden="true">↗</span>
      </a>
    </section>

    <section class="contact-details" aria-label="Informações de atendimento">
      <div>
        <p class="detail-label">Base</p>
        <p>{contact.location}<br />Disponível para novos projetos</p>
      </div>
      <div>
        <p class="detail-label">Retorno</p>
        <p>{contact.responseTime}<br />De segunda a sexta</p>
      </div>
      <div>
        <p class="detail-label">Instagram</p>
        <p>Bastidores e trabalhos recentes</p>
      </div>
    </section>

    <section class="contact-closing" data-cursor-inverse>
      <p class="eyebrow">Próxima história</p>
      <a href={`mailto:${contact.email}`}>Escreva para mim <span>↗</span></a>
      <p>© {new Date().getFullYear()} Sarah Heloísa</p>
    </section>
  </main>
</SiteLayout>

<style>
  .contact-page {
    overflow: hidden;
  }

  .contact-hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(300px, 0.7fr);
    min-height: calc(100svh - 112px);
    border-bottom: 1px solid var(--line);
  }

  .contact-intro {
    z-index: 1;
    display: flex;
    padding: clamp(70px, 8vw, 130px) clamp(24px, 5vw, 90px);
    flex-direction: column;
    justify-content: space-between;
  }

  .contact-intro h1 {
    margin: clamp(70px, 9vw, 150px) 0 0;
    font-size: clamp(76px, 12vw, 190px);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.085em;
  }

  .contact-intro h1 span {
    color: var(--accent);
  }

  .contact-note {
    z-index: 1;
    display: flex;
    padding: clamp(70px, 9vw, 140px) clamp(24px, 4vw, 70px);
    border-left: 1px solid var(--line);
    flex-direction: column;
    justify-content: flex-end;
  }

  .contact-note p {
    max-width: 480px;
    margin: 0;
    font-size: clamp(18px, 1.7vw, 27px);
    line-height: 1.42;
    letter-spacing: -0.04em;
  }

  .contact-note span {
    margin-top: 42px;
    color: var(--muted);
    font: 400 9px/1.5 "DM Mono", monospace;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .contact-at {
    position: absolute;
    top: 0;
    right: -0.07em;
    color: var(--accent);
    font-size: min(58vw, 880px);
    font-weight: 600;
    line-height: 0.8;
    letter-spacing: -0.14em;
    opacity: 0.08;
    pointer-events: none;
  }

  .contact-channels {
    border-bottom: 1px solid var(--line);
  }

  .channel {
    display: grid;
    grid-template-columns: minmax(110px, 0.32fr) 1fr auto;
    gap: 30px;
    align-items: center;
    min-height: 210px;
    padding: 32px clamp(24px, 5vw, 90px);
    border-bottom: 1px solid var(--line);
    text-decoration: none;
  }

  .channel:last-child {
    border-bottom: 0;
  }

  .channel-label,
  .detail-label {
    color: var(--muted);
    font: 400 10px/1.4 "DM Mono", monospace;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .channel strong {
    min-width: 0;
    font-size: clamp(30px, 5.2vw, 82px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.065em;
    overflow-wrap: anywhere;
  }

  .channel-arrow {
    font-size: clamp(28px, 3vw, 50px);
    transition: transform 300ms ease;
  }

  .channel:hover .channel-arrow {
    transform: translate(8px, -8px);
  }

  .contact-details {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .contact-details > div {
    min-height: 280px;
    padding: 42px clamp(24px, 4vw, 64px);
    border-right: 1px solid var(--line);
  }

  .contact-details > div:last-child {
    border-right: 0;
  }

  .contact-details p:last-child {
    margin: clamp(65px, 7vw, 105px) 0 0;
    font-size: clamp(16px, 1.35vw, 21px);
    line-height: 1.5;
  }

  .contact-closing {
    display: grid;
    min-height: 70vh;
    padding: clamp(70px, 9vw, 140px) clamp(24px, 5vw, 90px) 38px;
    background: var(--ink);
    color: var(--paper);
    grid-template-rows: auto 1fr auto;
  }

  .contact-closing > a {
    align-self: center;
    width: fit-content;
    border-bottom: 0.055em solid var(--accent);
    font-size: clamp(50px, 9vw, 142px);
    line-height: 0.95;
    letter-spacing: -0.075em;
    text-decoration: none;
  }

  .contact-closing > a span {
    color: var(--accent);
  }

  .contact-closing > p:last-child {
    margin: 0;
    color: var(--muted);
    font: 400 9px/1.4 "DM Mono", monospace;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .contact-hero {
      display: flex;
      min-height: calc(100svh - 78px);
      flex-direction: column;
    }

    .contact-intro {
      min-height: 55svh;
      padding: 68px 18px 54px;
    }

    .contact-intro h1 {
      margin-top: 80px;
      font-size: clamp(64px, 20.5vw, 86px);
    }

    .contact-note {
      padding: 56px 18px 70px;
      border-top: 1px solid var(--line);
      border-left: 0;
    }

    .contact-note p {
      width: 84%;
    }

    .contact-at {
      top: 22%;
      font-size: 92vw;
    }

    .channel {
      display: flex;
      min-height: 185px;
      padding: 28px 18px;
      flex-wrap: wrap;
    }

    .channel-label {
      width: 100%;
    }

    .channel strong {
      max-width: calc(100% - 54px);
      font-size: clamp(28px, 9vw, 40px);
    }

    .channel-arrow {
      margin-left: auto;
    }

    .contact-details {
      grid-template-columns: 1fr;
    }

    .contact-details > div {
      min-height: 220px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .contact-closing {
      min-height: 65vh;
      padding: 70px 18px 28px;
    }

    .contact-closing > a {
      font-size: clamp(47px, 14.5vw, 68px);
    }
  }
</style>
